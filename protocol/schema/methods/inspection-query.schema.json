    "locator":{"type":"object","additionalProperties":false,"required":["kind","text"],"properties":{"kind":{"type":"string","enum":["stack","register","scattered","other"]},"text":{"type":"string","maxLength":4096},"vdStackOffset":{"type":"integer"},"idaStackOffset":{"type":"integer"},"registers":{"type":"array","maxItems":16,"items":{"type":"string","maxLength":128}}}},
    "local":{"type":"object","additionalProperties":false,"required":["index","name","declaration","width","defBlock","defEa","locator","flags"],"properties":{"index":{"type":"integer","minimum":0,"maximum":1000000},"name":{"type":"string","maxLength":4096},"declaration":{"type":"string","maxLength":16384},"width":{"type":"integer","minimum":0},"defBlock":{"type":["integer","null"],"minimum":0},"defEa":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/address"}]},"locator":{"$ref":"#/$defs/locator"},"flags":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"type":"string","enum":["used","typed","nice_name","user_name","user_type","result","argument","fake","overlapped","partial_type","this_argument","dummy_argument","address_taken","shared"]}}}},
    "localsResult":{"type":"object","additionalProperties":false,"required":["entryAddress","totalCount","truncated","items"],"properties":{"entryAddress":{"$ref":"#/$defs/address"},"totalCount":{"type":"integer","minimum":0},"truncated":{"type":"boolean"},"items":{"type":"array","maxItems":512,"items":{"$ref":"#/$defs/local"}}}},
    "ctreeNode":{"type":"object","additionalProperties":false,"required":["ordinal","depth","kind","op","ea","userFlags"],"properties":{"ordinal":{"type":"integer","minimum":0,"maximum":999},"depth":{"type":"integer","minimum":0,"maximum":32},"kind":{"type":"string","enum":["expression","statement"]},"op":{"type":"string","minLength":1,"maxLength":128},"ea":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/address"}]},"userFlags":{"type":"array","maxItems":4,"uniqueItems":true,"items":{"type":"string","enum":["collapsed","inverted","then_collapsed","else_collapsed"]}},"type":{"type":"string","maxLength":16384},"lvarIndex":{"type":"integer","minimum":0,"maximum":1000000},"name":{"type":"string","maxLength":4096}}},
    "ctreeResult":{"type":"object","additionalProperties":false,"required":["entryAddress","count","truncated","nodes"],"properties":{"entryAddress":{"$ref":"#/$defs/address"},"count":{"type":"integer","minimum":0,"maximum":1000},"truncated":{"type":"boolean"},"nodes":{"type":"array","maxItems":1000,"items":{"$ref":"#/$defs/ctreeNode"}}}},
    "localXref":{"type":"object","additionalProperties":false,"required":["ordinal","depth","ea","parentOp","type"],"properties":{"ordinal":{"type":"integer","minimum":0,"maximum":511},"depth":{"type":"integer","minimum":0,"maximum":32},"ea":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/address"}]},"parentOp":{"type":["string","null"],"minLength":1,"maxLength":128},"type":{"type":["string","null"],"maxLength":16384}}},
    "localXrefsResult":{"type":"object","additionalProperties":false,"required":["entryAddress","localIndex","name","visitedNodes","totalReturned","truncated","items"],"properties":{"entryAddress":{"$ref":"#/$defs/address"},"localIndex":{"type":"integer","minimum":0,"maximum":1000000},"name":{"type":"string","maxLength":4096},"visitedNodes":{"type":"integer","minimum":0,"maximum":5000},"totalReturned":{"type":"integer","minimum":0,"maximum":512},"truncated":{"type":"boolean"},"items":{"type":"array","maxItems":512,"items":{"$ref":"#/$defs/localXref"}}}},
    "thread":{"type":"object","additionalProperties":false,"required":["threadId","name","current"],"properties":{"threadId":{"type":"integer","minimum":1},"name":{"type":["string","null"],"maxLength":4096},"current":{"type":"boolean"}}},
    "module":{"type":"object","additionalProperties":false,"required":["name","base","size","rebaseTo"],"properties":{"name":{"type":"string","minLength":1,"maxLength":4096,"pattern":"^[^/\\\\]*$"},"base":{"$ref":"#/$defs/address"},"size":{"type":"integer","minimum":0},"rebaseTo":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/address"}]}}},
    "indexPage":{"type":"object","additionalProperties":false,"required":["items","nextCursor","hasMore"],"properties":{"items":{"type":"array","maxItems":100},"nextCursor":{"type":["integer","null"],"minimum":0,"maximum":1000000},"hasMore":{"type":"boolean"}},"allOf":[{"if":{"properties":{"hasMore":{"const":true}},"required":["hasMore"]},"then":{"properties":{"nextCursor":{"type":"integer"}}}},{"if":{"properties":{"hasMore":{"const":false}},"required":["hasMore"]},"then":{"properties":{"nextCursor":{"type":"null"}}}}]},
    "addressPage":{"type":"object","additionalProperties":false,"required":["items","nextCursor","hasMore"],"properties":{"items":{"type":"array","maxItems":100},"nextCursor":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/address"}]},"hasMore":{"type":"boolean"}},"allOf":[{"if":{"properties":{"hasMore":{"const":true}},"required":["hasMore"]},"then":{"properties":{"nextCursor":{"$ref":"#/$defs/address"}}}},{"if":{"properties":{"hasMore":{"const":false}},"required":["hasMore"]},"then":{"properties":{"nextCursor":{"type":"null"}}}}]},
    "sourceFilesResult":{"allOf":[{"$ref":"#/$defs/indexPage"},{"properties":{"items":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/sourceFile"}}}}]},
    "sourceLinesResult":{"allOf":[{"$ref":"#/$defs/addressPage"},{"properties":{"items":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/sourceLine"}}}}]},
