    "demangleParams":{"type":"object","additionalProperties":false,"properties":{"address":{"$ref":"#/$defs/address"},"name":{"type":"string","minLength":1,"maxLength":4096}},"oneOf":[{"required":["address"],"not":{"required":["name"]}},{"required":["name"],"not":{"required":["address"]}}]},
    "commentParams":{"type":"object","additionalProperties":false,"required":["address"],"properties":{"address":{"$ref":"#/$defs/address"},"scope":{"type":"string","enum":["item","function"],"default":"item"},"repeatable":{"type":"boolean","default":false}}},
    "typeXrefsParams":{"type":"object","additionalProperties":false,"required":["name"],"properties":{"name":{"type":"string","minLength":1,"maxLength":4096},"limit":{"$ref":"#/$defs/limit"},"cursor":{"$ref":"#/$defs/indexCursor"}}},
