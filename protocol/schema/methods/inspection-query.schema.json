    "ctreeParams":{"type":"object","additionalProperties":false,"required":["address"],"properties":{"address":{"$ref":"#/$defs/address"},"maxDepth":{"type":"integer","minimum":1,"maximum":32,"default":8},"maxNodes":{"type":"integer","minimum":1,"maximum":1000,"default":200}}},
    "localXrefsParams":{"type":"object","additionalProperties":false,"required":["address","localIndex"],"properties":{"address":{"$ref":"#/$defs/address"},"localIndex":{"type":"integer","minimum":0,"maximum":1000000},"maxDepth":{"type":"integer","minimum":1,"maximum":32,"default":16},"maxNodes":{"type":"integer","minimum":1,"maximum":5000,"default":1000},"maxItems":{"type":"integer","minimum":1,"maximum":512,"default":100}}},
    "sourceFile":{"type":"object","additionalProperties":false,"required":["start","end","filename"],"properties":{"start":{"$ref":"#/$defs/address"},"end":{"$ref":"#/$defs/address"},"filename":{"type":"string","minLength":1,"maxLength":4096,"pattern":"^[^/\\\\]*$"}}},
    "sourceLine":{"type":"object","additionalProperties":false,"required":["address","line","filename"],"properties":{"address":{"$ref":"#/$defs/address"},"line":{"type":"integer","minimum":0},"filename":{"oneOf":[{"type":"null"},{"type":"string","maxLength":4096,"pattern":"^[^/\\\\]*$"}]}}},
