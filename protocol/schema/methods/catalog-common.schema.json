{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "emptyParams": {"type": "object", "additionalProperties": false},
    "systemPingResult": {
      "type": "object", "additionalProperties": false, "required": ["status"],
      "properties": {"status": {"const": "ok"}}
    },
    "systemMethodsResult": {
      "type": "object", "additionalProperties": false, "required": ["methods"],
      "properties": {"methods": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"}}}
    },
    "databaseSurveyParams": {
      "type": "object", "additionalProperties": false,
      "properties": {"mode": {"type": "string", "enum": ["full", "minimal"], "default": "full"}, "budget": {"type": "integer", "minimum": 3, "maximum": 100, "default": 60}}
    },
    "segmentSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "code", "data", "bss", "other", "readable", "writable", "executable"],
      "properties": {"total": {"type": "integer", "minimum": 0}, "code": {"type": "integer", "minimum": 0}, "data": {"type": "integer", "minimum": 0}, "bss": {"type": "integer", "minimum": 0}, "other": {"type": "integer", "minimum": 0}, "readable": {"type": "integer", "minimum": 0}, "writable": {"type": "integer", "minimum": 0}, "executable": {"type": "integer", "minimum": 0}}
    },
    "databaseMetadata": {
      "type": "object", "additionalProperties": false,
      "required": ["database", "processor", "architecture", "addressBits", "addressRange", "segments"],
      "properties": {"database": {"type": "string", "maxLength": 4096}, "processor": {"type": "string", "minLength": 1, "maxLength": 64}, "architecture": {"type": "string", "minLength": 1, "maxLength": 64}, "addressBits": {"type": "integer", "enum": [32, 64]}, "addressRange": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/addressRange"}]}, "segments": {"$ref": "#/$defs/segmentSummary"}}
    },
    "addressRange": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": {"start": {"$ref": "../common.schema.json#/$defs/address"}, "end": {"$ref": "../common.schema.json#/$defs/address"}}
    },
    "functionSummary": {
      "type": "object", "additionalProperties": false, "required": ["entryAddress", "name"],
      "properties": {"entryAddress": {"$ref": "../common.schema.json#/$defs/address"}, "name": {"type": "string", "minLength": 1, "maxLength": 1024}}
    },
    "stringItem": {
      "type": "object", "additionalProperties": false, "required": ["address", "length", "encoding", "value", "truncated", "originalSize"],
      "properties": {"address": {"$ref": "../common.schema.json#/$defs/address"}, "length": {"type": "integer", "minimum": 0}, "encoding": {"type": "string", "minLength": 1, "maxLength": 128}, "value": {"type": "string", "maxLength": 4096}, "truncated": {"type": "boolean"}, "originalSize": {"type": "integer", "minimum": 0}}
    },
    "databaseSurveyResult": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "metadata", "statistics", "importCategories", "callGraph", "metrics", "truncated", "budget", "functions", "strings"],
      "properties": {
        "mode": {"type": "string", "enum": ["full", "minimal"]}, "metadata": {"$ref": "#/$defs/databaseMetadata"},
        "statistics": {"type": "object", "additionalProperties": false, "required": ["sampledFunctions", "sampledStrings", "sampledImports", "functionsTruncated", "stringsTruncated", "importsTruncated"], "properties": {"sampledFunctions": {"type": "integer", "minimum": 0}, "sampledStrings": {"type": "integer", "minimum": 0}, "sampledImports": {"type": "integer", "minimum": 0}, "functionsTruncated": {"type": "boolean"}, "stringsTruncated": {"type": "boolean"}, "importsTruncated": {"type": "boolean"}}},
        "importCategories": {"type": "array", "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["module", "sampledCount"], "properties": {"module": {"type": "string", "minLength": 1, "maxLength": 1024}, "sampledCount": {"type": "integer", "minimum": 0}}}},
        "callGraph": {"type": "object", "additionalProperties": false, "required": ["roots", "nodes", "edges", "truncated"], "properties": {"roots": {"type": "integer", "minimum": 0}, "nodes": {"type": "integer", "minimum": 0}, "edges": {"type": "integer", "minimum": 0}, "truncated": {"type": "boolean"}}},
        "metrics": {"type": "object", "additionalProperties": false, "required": ["segments", "functions", "strings", "imports"], "properties": {"segments": {"type": "integer", "minimum": 0}, "functions": {"$ref": "#/$defs/surveyMetric"}, "strings": {"$ref": "#/$defs/surveyMetric"}, "imports": {"$ref": "#/$defs/surveyMetric"}}},
        "truncated": {"type": "boolean"}, "budget": {"type": "object", "additionalProperties": false, "required": ["requestedItems", "perSection"], "properties": {"requestedItems": {"type": "integer", "minimum": 3, "maximum": 100}, "perSection": {"type": "integer", "minimum": 1}}},
        "functions": {"oneOf": [{"$ref": "#/$defs/surveyFunctionsFull"}, {"$ref": "#/$defs/surveyMinimal"}]}, "strings": {"oneOf": [{"$ref": "#/$defs/surveyStringsFull"}, {"$ref": "#/$defs/surveyMinimal"}]}
      }
    },
    "surveyMetric": {"type": "object", "additionalProperties": false, "required": ["sampled", "hasMore"], "properties": {"sampled": {"type": "integer", "minimum": 0}, "hasMore": {"type": "boolean"}}},
    "surveyFunctionsFull": {"type": "object", "additionalProperties": false, "required": ["items", "nextCursor", "hasMore"], "properties": {"items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/functionSummary"}}, "nextCursor": {"type": ["string", "null"]}, "hasMore": {"type": "boolean"}}},
    "surveyStringsFull": {"type": "object", "additionalProperties": false, "required": ["items", "nextCursor", "hasMore"], "properties": {"items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/stringItem"}}, "nextCursor": {"type": ["string", "null"]}, "hasMore": {"type": "boolean"}}},
    "surveyMinimal": {"type": "object", "additionalProperties": false, "required": ["sampledCount", "hasMore"], "properties": {"sampledCount": {"type": "integer", "minimum": 0}, "hasMore": {"type": "boolean"}}},
    "databaseSaveParams": {"type": "object", "additionalProperties": false, "properties": {"target": {"type": "string", "minLength": 1, "maxLength": 4096}, "compact": {"type": "boolean", "default": false}, "backup": {"type": "boolean", "default": false}}},
    "databaseSaveResult": {"type": "object", "additionalProperties": false, "required": ["saved", "explicitTarget"], "properties": {"saved": {"const": true}, "explicitTarget": {"type": "boolean"}}},
    "functionCallGraphParams": {"type": "object", "additionalProperties": false, "required": ["roots"], "properties": {"roots": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "../common.schema.json#/$defs/address"}}, "direction": {"type": "string", "enum": ["callers", "callees", "both"], "default": "callees"}, "maxDepth": {"type": "integer", "minimum": 0, "maximum": 5, "default": 2}, "maxNodes": {"type": "integer", "minimum": 1, "maximum": 500, "default": 100}, "maxEdges": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 200}, "perFunction": {"type": "integer", "minimum": 1, "maximum": 100, "default": 100}}},
    "functionCallGraphResult": {"type": "object", "additionalProperties": false, "required": ["nodes", "edges", "truncated"], "properties": {"nodes": {"type": "array", "maxItems": 500, "items": {"type": "object", "additionalProperties": false, "required": ["address", "name", "depth"], "properties": {"address": {"$ref": "../common.schema.json#/$defs/address"}, "name": {"type": "string", "minLength": 1, "maxLength": 1024}, "depth": {"type": "integer", "minimum": 0, "maximum": 5}}}}, "edges": {"type": "array", "maxItems": 1000, "items": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"$ref": "../common.schema.json#/$defs/address"}, "to": {"$ref": "../common.schema.json#/$defs/address"}}}}, "truncated": {"type": "boolean"}}},
    "functionProfileParams": {"type": "object", "additionalProperties": false, "properties": {"name": {"type": "string", "maxLength": 1024}, "minSize": {"type": "integer", "minimum": 0, "maximum": 1048576, "default": 0}, "maxSize": {"type": "integer", "minimum": 1, "maximum": 1048576, "default": 1048576}, "library": {"type": "boolean"}, "thunk": {"type": "boolean"}, "includePrototype": {"type": "boolean", "default": false}, "sampleLimit": {"type": "integer", "minimum": 0, "maximum": 8, "default": 0}, "limit": {"type": "integer", "minimum": 1, "maximum": 50, "default": 20}, "cursor": {"type": "string", "pattern": "^fp1\\.[0-9a-f]{16}\\.[0-9a-f]{16}\\.[0-9a-f]{16}$"}}},
    "profileMetrics": {"type": "object", "additionalProperties": false, "required": ["sizeBytes", "instructions", "basicBlocks", "chunks"], "properties": {"sizeBytes": {"type": "integer", "minimum": 0}, "instructions": {"type": "integer", "minimum": 0}, "basicBlocks": {"type": "integer", "minimum": 0}, "chunks": {"type": "integer", "minimum": 0}}},
    "functionProfileResult": {"type": "object", "additionalProperties": false, "required": ["items", "nextCursor", "hasMore", "metrics"], "properties": {"items": {"type": "array", "maxItems": 50, "items": {"type": "object", "additionalProperties": false, "required": ["address", "name", "metrics", "flags"], "properties": {"address": {"$ref": "../common.schema.json#/$defs/address"}, "name": {"type": "string", "minLength": 1, "maxLength": 1024}, "metrics": {"$ref": "#/$defs/profileMetrics"}, "flags": {"type": "object", "additionalProperties": false, "required": ["library", "thunk"], "properties": {"library": {"type": "boolean"}, "thunk": {"type": "boolean"}}}, "prototype": {"type": ["string", "null"]}, "samples": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/disassemblyItem"}}, "samplesTruncated": {"type": "boolean"}}}}, "nextCursor": {"type": ["string", "null"]}, "hasMore": {"type": "boolean"}, "metrics": {"type": "object", "additionalProperties": false, "required": ["candidates", "matched", "sampledInstructions"], "properties": {"candidates": {"type": "integer", "minimum": 0}, "matched": {"type": "integer", "minimum": 0}, "sampledInstructions": {"type": "integer", "minimum": 0}}}}},
    "disassemblyItem": {"type": "object", "additionalProperties": false, "required": ["address", "text"], "properties": {"address": {"$ref": "../common.schema.json#/$defs/address"}, "text": {"type": "string", "maxLength": 4096}}},
    "functionExportParams": {"type": "object", "additionalProperties": false, "required": ["addresses", "format"], "properties": {"addresses": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "../common.schema.json#/$defs/address"}}, "format": {"type": "string", "enum": ["json", "c_header", "prototypes"]}, "maxBytes": {"type": "integer", "minimum": 1024, "maximum": 65536, "default": 32768}}},
    "functionExportResult": {"type": "object", "additionalProperties": false, "required": ["format", "content", "truncated", "originalSize"], "properties": {"format": {"type": "string", "enum": ["json", "c_header", "prototypes"]}, "content": {"type": "string", "maxLength": 65536}, "truncated": {"type": "boolean"}, "originalSize": {"type": "integer", "minimum": 0}}},
    "functionAnalyzeParams": {"type": "object", "additionalProperties": false, "required": ["addresses"], "properties": {"addresses": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "../common.schema.json#/$defs/address"}}, "sections": {"type": "array", "minItems": 1, "maxItems": 11, "uniqueItems": true, "items": {"$ref": "#/$defs/analysisSectionName"}}, "perSection": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}, "decompileBytes": {"type": "integer", "minimum": 1024, "maximum": 65536, "default": 16384}}},
    "analysisSectionName": {"type": "string", "enum": ["overview", "metrics", "prototype", "callers", "callees", "blocks", "xrefs", "strings", "constants", "comments", "decompile"]},
    "functionAnalyzeResult": {"type": "object", "additionalProperties": false, "required": ["sections", "items"], "properties": {"sections": {"type": "array", "minItems": 1, "maxItems": 11, "uniqueItems": true, "items": {"$ref": "#/$defs/analysisSectionName"}}, "items": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/functionAnalyzeItem"}}}},
    "functionAnalyzeItem": {"type": "object", "additionalProperties": false, "required": ["address"], "properties": {"address": {"$ref": "../common.schema.json#/$defs/address"}, "name": {"type": "string", "minLength": 1, "maxLength": 1024}, "error": {"const": "function_not_found"}, "range": {"$ref": "#/$defs/addressRange"}, "flags": {"$ref": "#/$defs/functionFlags"}, "prototype": {"type": ["string", "null"]}, "metrics": {"$ref": "#/$defs/profileMetrics"}, "callers": {"$ref": "#/$defs/callersSection"}, "callees": {"$ref": "#/$defs/calleesSection"}, "blocks": {"$ref": "#/$defs/blocksSection"}, "xrefs": {"$ref": "#/$defs/xrefsSection"}, "strings": {"$ref": "#/$defs/stringsSection"}, "constants": {"$ref": "#/$defs/constantsSection"}, "comments": {"$ref": "#/$defs/commentsSection"}, "decompile": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/decompileResult"}]}}},
    "functionFlags": {"type": "object", "additionalProperties": false, "required": ["noReturn", "far", "library", "static", "frame", "hidden", "thunk", "lumina", "outlined"], "properties": {"noReturn": {"type": "boolean"}, "far": {"type": "boolean"}, "library": {"type": "boolean"}, "static": {"type": "boolean"}, "frame": {"type": "boolean"}, "hidden": {"type": "boolean"}, "thunk": {"type": "boolean"}, "lumina": {"type": "boolean"}, "outlined": {"type": "boolean"}}},
    "callerItem": {"type": "object", "additionalProperties": false, "required": ["address", "name", "callSites"], "properties": {"address": {"$ref": "../common.schema.json#/$defs/address"}, "name": {"type": "string", "minLength": 1, "maxLength": 1024}, "callSites": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "../common.schema.json#/$defs/address"}}}},
    "calleeItem": {"type": "object", "additionalProperties": false, "required": ["address", "name", "internal"], "properties": {"address": {"$ref": "../common.schema.json#/$defs/address"}, "name": {"type": "string", "minLength": 1, "maxLength": 1024}, "internal": {"type": "boolean"}}},
    "blockItem": {"type": "object", "additionalProperties": false, "required": ["start", "end", "type", "successors", "predecessors"], "properties": {"start": {"$ref": "../common.schema.json#/$defs/address"}, "end": {"$ref": "../common.schema.json#/$defs/address"}, "type": {"type": "string", "enum": ["normal", "indirect_jump", "return", "conditional_return", "no_return", "external_no_return", "external", "error"]}, "successors": {"type": "array", "maxItems": 64, "items": {"$ref": "../common.schema.json#/$defs/address"}}, "predecessors": {"type": "array", "maxItems": 64, "items": {"$ref": "../common.schema.json#/$defs/address"}}}},
    "callersSection": {"type": "object", "additionalProperties": false, "required": ["items", "truncated"], "properties": {"entryAddress": {"$ref": "../common.schema.json#/$defs/address"}, "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/callerItem"}}, "nextOffset": {"type": ["integer", "null"], "minimum": 0}, "hasMore": {"type": "boolean"}, "truncated": {"type": "boolean"}}},
    "calleesSection": {"type": "object", "additionalProperties": false, "required": ["items", "truncated"], "properties": {"entryAddress": {"$ref": "../common.schema.json#/$defs/address"}, "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/calleeItem"}}, "nextOffset": {"type": ["integer", "null"], "minimum": 0}, "hasMore": {"type": "boolean"}, "truncated": {"type": "boolean"}}},
    "blocksSection": {"type": "object", "additionalProperties": false, "required": ["items", "truncated"], "properties": {"entryAddress": {"$ref": "../common.schema.json#/$defs/address"}, "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/blockItem"}}, "nextOffset": {"type": ["integer", "null"], "minimum": 0}, "hasMore": {"type": "boolean"}, "truncated": {"type": "boolean"}}},
    "xrefItem": {"type": "object", "additionalProperties": false, "required": ["from", "to", "type", "code", "userDefined"], "properties": {"from": {"$ref": "../common.schema.json#/$defs/address"}, "to": {"$ref": "../common.schema.json#/$defs/address"}, "type": {"type": "string", "minLength": 1, "maxLength": 128}, "code": {"type": "boolean"}, "userDefined": {"type": "boolean"}}},
    "constantItem": {"type": "object", "additionalProperties": false, "required": ["address", "value"], "properties": {"address": {"$ref": "../common.schema.json#/$defs/address"}, "value": {"type": "string", "minLength": 1, "maxLength": 1024}}},
    "commentItem": {"type": "object", "additionalProperties": false, "required": ["address", "text"], "properties": {"address": {"$ref": "../common.schema.json#/$defs/address"}, "text": {"type": "string", "maxLength": 4096}}},
    "xrefsSection": {"type": "object", "additionalProperties": false, "required": ["items", "truncated"], "properties": {"items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/xrefItem"}}, "truncated": {"type": "boolean"}}},
    "stringsSection": {"type": "object", "additionalProperties": false, "required": ["items", "truncated"], "properties": {"items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/stringItem"}}, "truncated": {"type": "boolean"}}},
    "constantsSection": {"type": "object", "additionalProperties": false, "required": ["items", "truncated"], "properties": {"items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/constantItem"}}, "truncated": {"type": "boolean"}}},
    "commentsSection": {"type": "object", "additionalProperties": false, "required": ["items", "truncated"], "properties": {"items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/commentItem"}}, "truncated": {"type": "boolean"}}},
    "decompileResult": {"type": "object", "additionalProperties": false, "required": ["entryAddress", "pseudocode", "offset", "returnedSize", "originalSize", "truncated", "nextOffset"], "properties": {"entryAddress": {"$ref": "../common.schema.json#/$defs/address"}, "pseudocode": {"type": "string", "maxLength": 65536}, "offset": {"type": "integer", "minimum": 0}, "returnedSize": {"type": "integer", "minimum": 0, "maximum": 65536}, "originalSize": {"type": "integer", "minimum": 0}, "truncated": {"type": "boolean"}, "nextOffset": {"type": ["integer", "null"], "minimum": 0}}},
    "functionStackFrameParams": {"type": "object", "additionalProperties": false, "required": ["address"], "properties": {"address": {"$ref": "../common.schema.json#/$defs/address"}}},
    "functionStackFrameResult": {"type": "object", "additionalProperties": false, "required": ["entryAddress", "size", "variables"], "properties": {"entryAddress": {"$ref": "../common.schema.json#/$defs/address"}, "size": {"type": "integer", "minimum": 0}, "variables": {"type": "array", "maxItems": 4096, "items": {"type": "object", "additionalProperties": false, "required": ["name", "declaration", "bitOffset", "bitSize", "role"], "properties": {"name": {"type": "string", "maxLength": 1024}, "declaration": {"type": "string", "maxLength": 4096}, "bitOffset": {"type": "integer"}, "bitSize": {"type": "integer", "minimum": 0}, "role": {"type": "string", "enum": ["argument", "local", "return_address", "saved_register"]}}}}}
  }
}
}
