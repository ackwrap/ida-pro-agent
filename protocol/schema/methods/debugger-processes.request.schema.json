{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../request.schema.json"
    },
    {
      "properties": {
        "method": {
          "const": "debugger.processes"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            }
          }
        }
      }
    }
  ]
}
