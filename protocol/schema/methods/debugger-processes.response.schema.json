{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../response.schema.json"
    },
    {
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "pid": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 32768,
                    "pattern": "^[^\\x00]*$"
                  }
                },
                "required": [
                  "pid",
                  "name"
                ]
              }
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "items",
            "total",
            "truncated"
          ]
        }
      }
    }
  ]
}
