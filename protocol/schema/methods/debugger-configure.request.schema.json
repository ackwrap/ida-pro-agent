{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../request.schema.json"
    },
    {
      "properties": {
        "method": {
          "const": "debugger.configure"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 32768,
              "pattern": "^[^\\x00]*$"
            },
            "arguments": {
              "type": "string",
              "maxLength": 32768,
              "pattern": "^[^\\x00]*$"
            },
            "directory": {
              "type": "string",
              "maxLength": 32768,
              "pattern": "^[^\\x00]*$"
            },
            "host": {
              "type": "string",
              "maxLength": 1024,
              "pattern": "^[^\\x00]*$"
            },
            "password": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^[^\\x00]*$"
            },
            "port": {
              "type": "integer",
              "minimum": -1,
              "maximum": 65535,
              "not": {
                "const": 0
              }
            }
          },
          "minProperties": 1
        }
      }
    }
  ]
}
