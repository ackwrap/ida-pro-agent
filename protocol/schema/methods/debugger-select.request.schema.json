{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../request.schema.json"
    },
    {
      "properties": {
        "method": {
          "const": "debugger.select"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[^\\x00]*$",
              "minLength": 1
            },
            "remote": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "name"
          ]
        }
      }
    }
  ]
}
