{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "string.search Success Response",
  "allOf": [
    {"$ref": "../response.schema.json"},
    {
      "type": "object",
      "required": ["result"],
      "properties": {
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["items", "nextCursor", "hasMore"],
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["address", "length", "encoding", "value", "truncated", "originalSize"],
                "properties": {
                  "address": {"$ref": "../common.schema.json#/$defs/address"},
                  "length": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
                  "encoding": {"type": "string", "minLength": 1, "maxLength": 128},
                  "value": {"type": "string", "maxLength": 4096},
                  "truncated": {"type": "boolean"},
                  "originalSize": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
                }
              }
            },
            "nextCursor": {
              "oneOf": [
                {"type": "null"},
                {"$ref": "string-search.request.schema.json#/$defs/cursor"}
              ]
            },
            "hasMore": {"type": "boolean"}
          },
          "allOf": [
            {
              "if": {"properties": {"hasMore": {"const": true}}, "required": ["hasMore"]},
              "then": {"properties": {"nextCursor": {"$ref": "string-search.request.schema.json#/$defs/cursor"}}}
            },
            {
              "if": {"properties": {"hasMore": {"const": false}}, "required": ["hasMore"]},
              "then": {"properties": {"nextCursor": {"type": "null"}}}
            }
          ]
        }
      }
    }
  ]
}
