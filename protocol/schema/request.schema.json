{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IDA RPC Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "requestId",
    "sessionId",
    "method",
    "params",
    "timeoutMs"
  ],
  "properties": {
    "protocolVersion": {
      "$ref": "common.schema.json#/$defs/protocolVersion"
    },
    "requestId": {
      "$ref": "common.schema.json#/$defs/requestId"
    },
    "sessionId": {
      "$ref": "common.schema.json#/$defs/sessionId"
    },
    "method": {
      "$ref": "common.schema.json#/$defs/method"
    },
    "params": {
      "type": "object"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120000
    }
  }
}
