{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IDA RPC Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "requestId",
    "sessionId"
  ],
  "properties": {
    "protocolVersion": {
      "$ref": "common.schema.json#/$defs/protocolVersion"
    },
    "requestId": {
      "$ref": "common.schema.json#/$defs/requestId"
    },
    "sessionId": {
      "$ref": "common.schema.json#/$defs/sessionId"
    },
    "result": {
      "type": "object"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "$ref": "common.schema.json#/$defs/errorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "retryable": {
          "type": "boolean"
        },
        "recoveryChangeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9._:-]+$"
        }
      },
      "allOf": [
        {
          "if": {"required": ["recoveryChangeId"]},
          "then": {"properties": {"code": {"const": "INTERNAL_ERROR"}}}
        }
      ]
    }
  },
  "oneOf": [
    {
      "required": ["result"],
      "not": {
        "required": ["error"]
      }
    },
    {
      "required": ["error"],
      "not": {
        "required": ["result"]
      }
    }
  ]
}
